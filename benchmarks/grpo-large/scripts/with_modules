#!/bin/bash
# Load environment modules on a remote node before running a command.
#
# milabench SSHes into each node with a *non-interactive, non-login* shell,
# which does not source the cluster module system. As a result CUDA_HOME is
# unset (DeepSpeed aborts with MissingCUDAException) and module-provided libs
# (NCCL, cuda runtime) are not on the library path. This wrapper makes the
# `module` function available, loads the requested modules, then execs the
# real command.
#
# Usage:
#   with_modules <module> [<module> ...] -- <command> [args ...]
set -e

# Make the `module` shell function available in this non-login shell.
if [ -z "$(type -t module)" ]; then
    for init in /etc/profile.d/modules.sh \
                "${MODULESHOME}/init/bash" \
                /cm/local/apps/environment-modules/current/init/bash; do
        if [ -r "$init" ]; then
            # shellcheck disable=SC1090
            source "$init"
            break
        fi
    done
fi

# Collect module names up to the `--` separator.
mods=()
while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
    mods+=("$1")
    shift
done
[ "$1" = "--" ] && shift

if [ "${#mods[@]}" -gt 0 ]; then
    # module load chatter goes to stderr, keeping stdout clean for metrics.
    module load "${mods[@]}"
fi

# NCCL inter-node socket interface. milabench's non-interactive SSH shell never
# sources ~/.bashrc (it `return`s early on the non-interactive guard), so any
# NCCL_SOCKET_IFNAME exported there never reaches the remote ranks. Without it
# NCCL auto-selects an interface and on this cluster picks an InfiniBand-over-IP
# rail (100.126.x.x) that is NOT routable between nodes, so process-group init
# dies with "socketPollConnect ... No route to host". bond0 (10.28.1.x) is the
# routable Ethernet that SSH itself uses. Override by exporting the var before
# the run if your cluster differs.
export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-bond0}"

# CUDA caching-allocator policy. `expandable_segments:True` lets the allocator
# grow/shrink segments instead of pre-committing fixed blocks, which cuts
# fragmentation-driven OOMs on the trainer ranks (72B Zero-3 runs right up to
# the 80 GB ceiling). Same rationale as NCCL above: it must be exported into
# the remote rank's env here, because ~/.bashrc is skipped over non-interactive
# SSH. Harmless for the vLLM rank too. Override by exporting it before the run.
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"

exec "$@"
